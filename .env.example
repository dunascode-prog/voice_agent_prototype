# Voice AI Agent Prototype: example environment
# Copy to .env and fill in your own values. Never commit .env.
# Phase 1 needs: PUBLIC_BASE_URL, MEDIA_WS_URL, INTERNAL_API_TOKEN, STREAM_TOKEN_SIGNING_KEY,
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, DEEPGRAM_API_KEY,
# ANTHROPIC_API_KEY, CARTESIA_API_KEY, CARTESIA_VOICE_ID_EN.
# In AWS, secrets are injected from Secrets Manager instead of this file.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
MEDIA_WS_URL=wss://your-subdomain.ngrok-free.app/media
INTERNAL_API_TOKEN=change-me
STREAM_TOKEN_SIGNING_KEY=change-me
STREAM_TOKEN_TTL_S=120
MAX_CALL_DURATION_S=1800
MAX_CONCURRENT_CALLS_PER_TASK=8
DEFAULT_TIMEZONE=America/New_York

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_PHONE_NUMBER=+15555550100
TWILIO_REGION=us1
TWILIO_EDGE=ashburn
# Only ever false in automated tests; never in a deployed environment.
TWILIO_VALIDATE_SIGNATURES=true
TRANSFER_DEFAULT_NUMBER=+15555550199
AMD_ENABLED=true
RECORDING_ENABLED=true

# --- STT: Deepgram ---
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# --- LLM: Claude ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=1024
LLM_FALLBACK_PROVIDER=bedrock
JUDGE_MODEL=claude-opus-5-5
AWS_REGION=us-east-1

# --- TTS ---
CARTESIA_API_KEY=your-cartesia-key
CARTESIA_VOICE_ID_EN=your-english-voice-id
CARTESIA_VOICE_ID_ES=your-spanish-voice-id
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id

# --- Agent behaviour ---
PLAYBOOK=booking
VAD_STOP_SECS=0.2

# --- Tools: calendar and CRM (used from phase 3) ---
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
GOOGLE_CALENDAR_ID=primary
CRM_PROVIDER=hubspot
HUBSPOT_PRIVATE_APP_TOKEN=your-hubspot-token
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

# --- Storage ---
# Without Docker: leave the SQLite default and an empty REDIS_URL (in-memory live state).
# docker compose overrides both with its own Postgres and Redis.
DATABASE_URL=sqlite+aiosqlite:///./voice_local.db
REDIS_URL=
LIVE_STATE_TTL_S=7200
# Used from phase 5:
S3_BUCKET_RECORDINGS=voice-agent-recordings-local
S3_BUCKET_TRANSCRIPTS=voice-agent-transcripts-local
SQS_QUEUE_URL_CALL_EVENTS=http://localstack:4566/000000000000/call-events
AWS_ENDPOINT_URL=http://localstack:4566

# --- Outbound dialer ---
CALLING_WINDOW_START=08:00
CALLING_WINDOW_END=21:00

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=voice-agent
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com
