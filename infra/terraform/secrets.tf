# Two secrets, injected into the containers by ECS as environment variables:
#
# - <name>/app: third-party keys. Terraform creates it with empty values and never
#   touches the values again; fill it with `scripts/aws/push_secrets.py` (reads your .env).
# - <name>/internal: values Terraform generates (database URL, internal tokens).

locals {
  app_secret_keys = [
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_PHONE_NUMBER",
    "DEEPGRAM_API_KEY",
    "CARTESIA_API_KEY",
    "CARTESIA_VOICE_ID_EN",
  ]
  internal_secret_keys = ["DATABASE_URL", "INTERNAL_API_TOKEN", "STREAM_TOKEN_SIGNING_KEY"]
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.name}/app"
  description             = "Third-party API keys for the voice agent (set with scripts/aws/push_secrets.py)"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "app_placeholder" {
  secret_id     = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({ for k in local.app_secret_keys : k => "" })

  # ECS refuses to start a task if a referenced JSON key is missing, so every key
  # exists from the start. Real values are pushed outside Terraform.
  lifecycle {
    ignore_changes = [secret_string]
  }
}

resource "random_password" "internal_api_token" {
  length  = 43
  special = false
}

resource "random_password" "stream_token_signing_key" {
  length  = 43
  special = false
}

resource "aws_secretsmanager_secret" "internal" {
  name                    = "${var.name}/internal"
  description             = "Generated by Terraform: database URL and internal tokens"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "internal" {
  secret_id = aws_secretsmanager_secret.internal.id
  secret_string = jsonencode({
    # RDS Postgres 16 requires TLS (rds.force_ssl=1).
    DATABASE_URL             = "postgresql://${aws_db_instance.main.username}:${random_password.db.result}@${aws_db_instance.main.address}:${aws_db_instance.main.port}/${aws_db_instance.main.db_name}?ssl=require"
    INTERNAL_API_TOKEN       = random_password.internal_api_token.result
    STREAM_TOKEN_SIGNING_KEY = random_password.stream_token_signing_key.result
  })
}
