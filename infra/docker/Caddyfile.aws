# Single-server AWS demo: CloudFront -> :80 (host) -> :8080 (this proxy).
# Only requests with CloudFront's secret header get through, so the server's own
# address is not a way around CloudFront. `route` keeps the directives in this order.
:8080 {
	route {
		@unverified not header X-Origin-Verify {$ORIGIN_VERIFY}
		respond @unverified "forbidden" 403
		reverse_proxy /media* agent:8001
		reverse_proxy gateway:8000
	}
}
